# Notion: eigene Internal Integration unter https://www.notion.so/my-integrations anlegen,
# den "Internal Integration Secret" hier eintragen. Die Zielseite (NOTION_PARENT_PAGE_ID)
# muss anschliessend in Notion mit dieser Integration verbunden werden (Seite -> "..." ->
# "Connections" -> Integration hinzufuegen), sonst schlagen alle Aufrufe mit 404 fehl.
NOTION_TOKEN=secret_xxx

# ID der Notion-Seite, unter der die vier job-radar-Datenbanken angelegt werden sollen
# (z.B. eine neue leere Seite "job-radar" in deinem Workspace). Aus der Seiten-URL kopieren,
# der Teil nach dem letzten "-" bzw. die letzten 32 Zeichen vor "?".
NOTION_PARENT_PAGE_ID=

# n8n: Basis-URL deiner Instanz (ohne trailing slash) und ein API-Key mit Workflow-Rechten
# (n8n -> Settings -> API -> Create an API Key).
N8N_BASE_URL=https://deine-n8n-instanz.example.com
N8N_API_KEY=
