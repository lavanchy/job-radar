    {
      "id": "a1a07450-2f07-4470-8d3b-b00759dceebf",
      "name": "Strategie routen",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [896, 368],
      "parameters": {
        "rules": {
          "values": [
            { "outputKey": "rss", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.property_strategie }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "RSS-native" }, { "leftValue": "={{ $json.property_strategie }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "RSS-Bridge" }], "combinator": "or" } },
            { "outputKey": "http", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.property_strategie }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "API" }, { "leftValue": "={{ $json.property_strategie }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "Scraping" }], "combinator": "or" } }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "Unbekannt" }
      }
    },
    {
      "id": "57a693f8-a257-4e6e-99cf-16000a53dc56",
      "name": "RSS/RSS-Bridge Feed lesen",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [1120, 176],
      "parameters": { "url": "={{ $json.property_such_query_oder_feed_url }}" },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "1ebbc786-95ec-42a1-996d-af8d6b2b2070",
      "name": "RSS normalisieren",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1344, 176],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "titel", "type": "string", "value": "={{ $json.title }}" },
            { "id": "n2", "name": "firma", "type": "string", "value": "={{ $json.creator || $json.author || '' }}" },
            { "id": "n3", "name": "link", "type": "string", "value": "={{ $json.link }}" },
            { "id": "n4", "name": "beschreibung", "type": "string", "value": "={{ $json.contentSnippet || $json.content || '' }}" },
            { "id": "n5", "name": "gefundenAm", "type": "string", "value": "={{ $json.pubDate || $now.toISO() }}" },
            { "id": "n6", "name": "plattformId", "type": "string", "value": "={{ $(\"Plattform: Letzter Lauf setzen\").item.json.id }}" },
            { "id": "n7", "name": "plattformName", "type": "string", "value": "={{ $(\"Plattform: Letzter Lauf setzen\").item.json.property_name }}" }
          ]
        }
      }
    },
    {
      "id": "86b8bb3f-5219-4ec6-93bb-490b755d58ad",
      "name": "Dedup-Hash berechnen",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1568, 288],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": { "assignments": [{ "id": "dh1", "name": "dedupHash", "type": "string", "value": "={{ $json.plattformId + \"::\" + $json.link }}" }] }
      }
    },
    {
      "id": "7d478e62-c697-4e24-9844-36e924e188a0",
      "name": "Dedup-Check in Treffer-DB",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 3,
      "position": [1792, 288],
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "dataSourceId": { "__rl": true, "mode": "id", "value": "REPLACE_ME_TREFFER_DATA_SOURCE_ID" },
        "returnAll": false,
        "limit": 1,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": { "conditions": [{ "key": "Dedup-Hash|rich_text", "condition": "equals", "richTextValue": "={{ $json.dedupHash }}" }] },
        "simple": true
      },
      "alwaysOutputData": true,
      "credentials": { "notionApi": { "id": "REPLACE_ME", "name": "Notion account" } }
    },
    {
      "id": "135abdc5-16ae-4fc3-a2b0-1f7d946e7b0e",
      "name": "Bereits vorhanden?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [2016, 288],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "leftValue": "={{ $json.id ? \"vorhanden\" : \"leer\" }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "leer" }],
          "combinator": "and"
        }
      }
    },
    {
      "id": "86e73a3d-ce44-41e7-9a14-0ece1d881005",
      "name": "Treffer anlegen",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 3,
      "position": [2240, 192],
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "dataSourceId": { "__rl": true, "mode": "id", "value": "REPLACE_ME_TREFFER_DATA_SOURCE_ID" },
        "title": "={{ $(\"Dedup-Hash berechnen\").item.json.titel }}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "Firma|rich_text", "textContent": "={{ $(\"Dedup-Hash berechnen\").item.json.firma }}" },
            { "key": "Link|url", "urlValue": "={{ $(\"Dedup-Hash berechnen\").item.json.link }}" },
            { "key": "Beschreibung|rich_text", "textContent": "={{ $(\"Dedup-Hash berechnen\").item.json.beschreibung }}" },
            { "key": "Gefunden am|date", "date": "={{ $(\"Dedup-Hash berechnen\").item.json.gefundenAm }}", "range": false, "includeTime": false },
            { "key": "Plattform|relation", "relationValue": ["={{ $(\"Dedup-Hash berechnen\").item.json.plattformId }}"] },
            { "key": "Dedup-Hash|rich_text", "textContent": "={{ $(\"Dedup-Hash berechnen\").item.json.dedupHash }}" },
            { "key": "Status|status", "statusValue": "Neu" }
          ]
        },
        "simple": true
      },
      "credentials": { "notionApi": { "id": "REPLACE_ME", "name": "Notion account" } }
    },
    {
      "id": "ee5f93fe-eb06-4699-9583-bad5ac1b2c0a",
