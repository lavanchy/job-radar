{
  "name": "job-radar: Backfill fehlende Fit-Scores",
  "nodes": [
    {
      "id": "47b1cbf3-71a4-45f6-afc5-6724fcbd80e5",
      "name": "Woechentlicher Backfill-Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 144],
      "parameters": { "rule": { "interval": [{ "field": "weeks" }] } }
    },
    {
      "id": "f9dea442-69f0-44ef-ae69-e7752b091284",
      "name": "Treffer ohne Fit-Score holen",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 3,
      "position": [224, 144],
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "dataSourceId": { "__rl": true, "mode": "id", "value": "REPLACE_ME_TREFFER_DATA_SOURCE_ID" },
        "returnAll": true,
        "filterType": "none",
        "simple": true
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 2000,
      "credentials": { "notionApi": { "id": "REPLACE_ME", "name": "Notion account" } }
    },
    {
      "id": "6de74898-3d9d-469b-8858-a8ce9502eea1",
      "name": "Nur ohne Fit-Score",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [448, 144],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "leftValue": "={{ $json.property_fit_score === undefined || $json.property_fit_score === null ? 'leer' : 'vorhanden' }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "leer" }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "f82d816b-aabe-4523-807e-5deddc13796e",
      "name": "Treffer fuer Treffer",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [672, 144],
      "parameters": { "batchSize": 1 }
    },
    {
      "id": "3196f209-7bf8-4a79-b5b4-20f1ef155cb6",
      "name": "Fit-Score ermitteln (Backfill)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [896, 192],
      "parameters": {
        "mode": "each",
        "source": "database",
        "workflowId": { "__rl": true, "mode": "id", "value": "REPLACE_ME_FIT_SCORE_WORKFLOW_ID" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": { "trefferPageId": "={{ $json.id }}" },
          "matchingColumns": [],
          "schema": [{ "id": "trefferPageId", "displayName": "trefferPageId", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" }]
        },
        "options": { "waitForSubWorkflow": true }
      }
    },
    {
      "id": "f538bd5f-80c8-44ee-921f-8573c6126211",
      "name": "Backfill abgeschlossen",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [896, 0],
      "parameters": {}
    }
  ],
  "connections": {
    "Woechentlicher Backfill-Check": { "main": [[{ "node": "Treffer ohne Fit-Score holen", "type": "main", "index": 0 }]] },
    "Treffer ohne Fit-Score holen": { "main": [[{ "node": "Nur ohne Fit-Score", "type": "main", "index": 0 }]] },
    "Nur ohne Fit-Score": { "main": [[{ "node": "Treffer fuer Treffer", "type": "main", "index": 0 }]] },
    "Treffer fuer Treffer": { "main": [[{ "node": "Backfill abgeschlossen", "type": "main", "index": 0 }], [{ "node": "Fit-Score ermitteln (Backfill)", "type": "main", "index": 0 }]] },
    "Fit-Score ermitteln (Backfill)": { "main": [[{ "node": "Treffer fuer Treffer", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
